<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="inkwell">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="posts"/>
            </not>
        </preConditions>
        <createTable tableName="posts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="author_name" type="VARCHAR(255)"/>
            <column name="category_id" type="BIGINT"/>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(500)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="content" type="LONGTEXT"/>
            <column name="excerpt" type="TEXT"/>
            <column name="featured_image_url" type="VARCHAR(255)"/>
            <column name="read_time" type="INT"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_featured" type="BIT"/>
            <column name="view_count" type="INT" defaultValueNumeric="0"/>
            <column name="like_count" type="INT" defaultValueNumeric="0"/>
            <column name="comment_count" type="INT" defaultValueNumeric="0"/>
            <column name="published_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
