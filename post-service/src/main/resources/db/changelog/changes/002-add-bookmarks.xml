<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="2" author="inkwell">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bookmarks"/>
            </not>
        </preConditions>
        <createTable tableName="bookmarks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="post_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="bookmarks" columnNames="user_id, post_id" constraintName="uc_bookmark_user_post"/>
        <addForeignKeyConstraint baseTableName="bookmarks" baseColumnNames="post_id" constraintName="fk_bookmark_post" referencedTableName="posts" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
