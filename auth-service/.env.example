# ============================================================
#  auth-service — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================

# --- Server ---
AUTH_SERVICE_PORT=
INTERNAL_SECRET=

# --- MySQL Database ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Redis ---
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBIT_HOST=
RABBIT_PORT=
RABBIT_USER=
RABBIT_PASSWORD=

# --- SMTP (Gmail) ---
# Use a Gmail App Password, NOT your account password.
# Google Account → Security → 2-Step Verification → App Passwords
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- JWT ---
# Generate a strong 256-bit (64 hex chars) secret. Example:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=

# --- OAuth2: Google ---
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GATEWAY_URL=

# --- OAuth2: GitHub ---
# GitHub → Settings → Developer Settings → OAuth Apps → New OAuth App
# Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Service Discovery ---
EUREKA_URL=

# --- API Gateway base URL (used for OAuth2 redirects) ---
GATEWAY_URL=
OAUTH2_REDIRECT_URL=

# --- Razorpay Payment Gateway ---
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use TEST keys during development, LIVE keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Initialization
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password
