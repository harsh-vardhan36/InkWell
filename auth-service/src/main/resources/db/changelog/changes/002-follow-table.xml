<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="2" author="inkwell">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="follows"/>
            </not>
        </preConditions>
        <createTable tableName="follows">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="follower_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="followed_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="follows" columnNames="follower_id, followed_id" constraintName="uk_follower_followed"/>
        <addForeignKeyConstraint baseTableName="follows" baseColumnNames="follower_id" constraintName="fk_follow_follower" referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="follows" baseColumnNames="followed_id" constraintName="fk_follow_followed" referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
