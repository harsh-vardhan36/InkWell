<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="inkwell">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="subscribers"/>
            </not>
        </preConditions>
        <createTable tableName="subscribers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(50)"/>
            <column name="confirmation_token" type="VARCHAR(255)"/>
            <column name="token_expiry" type="DATETIME"/>
            <column name="preferences" type="VARCHAR(255)"/>
            <column name="subscribed_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="unsubscribed_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
