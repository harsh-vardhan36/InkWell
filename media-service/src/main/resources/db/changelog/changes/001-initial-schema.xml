<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="inkwell">
        <createTable tableName="media">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="original_name" type="VARCHAR(255)"/>
            <column name="file_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="mime_type" type="VARCHAR(100)"/>
            <column name="size_kb" type="BIGINT"/>
            <column name="uploader_id" type="BIGINT"/>
            <column name="is_deleted" type="BIT" defaultValueBoolean="false"/>
            <column name="alt_text" type="VARCHAR(255)"/>
            <column name="linked_post_id" type="BIGINT"/>
            <column name="uploaded_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
