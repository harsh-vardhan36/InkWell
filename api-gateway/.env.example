# ============================================================
#  api-gateway — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================

# --- Server ---
API_GATEWAY_PORT=

# --- JWT ---
# Must be the SAME secret as used in auth-service.
JWT_SECRET=

# --- Internal Secret ---
# Must match INTERNAL_SECRET in auth-service .env
INTERNAL_SECRET=

# --- Redis ---
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- Service Discovery ---
EUREKA_URL=
